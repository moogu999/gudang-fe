# API Configuration
# Base URL for the backend API
# Example: http://localhost:8080, https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:8080

# Apache Superset Configuration (if using embedded dashboards)
# VITE_SUPERSET_URL=https://superset.yourdomain.com
# VITE_SUPERSET_GUEST_TOKEN=your_guest_token_here

# Application Configuration
# VITE_APP_TITLE=Gudang Management System
# VITE_APP_DEFAULT_LOCALE=en-US

# Development Settings
# NODE_ENV=development

# Base map style (MapLibre style URL) for the customer location picker and route map.
# Defaults to the public OpenFreeMap "liberty" style, which needs no key. Swap to MapTiler
# (e.g. https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY), a self-hosted
# OpenFreeMap, or a self-hosted Protomaps style without touching code.
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
